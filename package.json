{
  "name": "desk-calendar",
  "version": "1.1.1",
  "description": "한국 공휴일과 반복 일정·알림을 지원하는 데스크톱 캘린더",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "dist": "electron-builder --win nsis --publish never",
    "dist:portable": "electron-builder --win portable --publish never"
  },
  "license": "MIT",
  "author": "thatcathat",
  "repository": {
    "type": "git",
    "url": "https://github.com/thatcathat/KSJ_Calender.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "korean-lunar-calendar": "^0.4.0",
    "rrule": "^2.8.1"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "productName": "DeskCalendar",
  "build": {
    "appId": "com.deskcalendar.app",
    "productName": "DeskCalendar",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "renderer/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "데스크 캘린더",
      "uninstallDisplayName": "데스크 캘린더",
      "artifactName": "DeskCalendar-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "DeskCalendar-portable-${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "thatcathat",
      "repo": "KSJ_Calender",
      "releaseType": "release"
    },
    "directories": {
      "output": "dist"
    }
  }
}
