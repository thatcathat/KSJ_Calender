{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeskCalendar",
  "version": "../package.json",
  "identifier": "com.deskcalendar.app",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "thatcathat",
    "shortDescription": "데스크 캘린더",
    "longDescription": "한국 공휴일과 반복 일정·알림을 지원하는 데스크톱 캘린더",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Korean"],
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
